# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/it_asset_tracker
DB_ENCRYPTION_SECRET=your_32_character_encryption_secret_here

# Security & Authentication
JWT_SECRET=your_jwt_access_secret_here
REFRESH_SECRET=your_jwt_refresh_secret_here
BACKUP_SECRET=your_32_character_backup_encryption_secret_here

# Third-Party APIs
RESEND_API_KEY=your_resend_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Client Configuration
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Email Integration (Fallback)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
ADMIN_EMAIL=your_admin_email@gmail.com
ADMIN_PASSWORD=replace_with_a_strong_initial_admin_password
